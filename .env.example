# Runtime database login with the app_runtime role's least-privilege membership.
# Never commit an actual connection string.
DATABASE_URL=postgresql://app_runtime_login:replace-me@db.example.test:5432/kayyal

# Supabase Auth project URL and public/publishable key. These are required by
# server-side owner-cookie verification and must be HTTPS outside local dev.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# These values are embedded into the owner browser login bundle at build time.
# They must describe the same Supabase project as the server-side values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Do NOT add SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SERVICE_ROLE, a Supabase JWT
# secret, operator PINs, session tokens, or production database credentials.
